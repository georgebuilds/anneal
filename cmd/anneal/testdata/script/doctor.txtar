# `doctor` probes the WebGPU adapter — gate on [gpu] so CI without a GPU
# still passes. The body checks the success-path output.

[!gpu] skip 'no WebGPU adapter — doctor needs hardware'

# Mesa shader cache writes to $HOME/.cache; testscript defaults HOME=/no-home.
env HOME=$WORK
env XDG_CACHE_HOME=$WORK/.cache

anneal doctor
stdout '^device: '
stdout '^backend: '
stdout '^shader-f16: '
stdout 'status: '
stdout 'ready'
! stderr .
